#compdef pi
# zsh completion for pi (spec version 0.84.2)
# Generated by pi-completion, then manually extended for pi 1.0.4 (mcp / --no-mcp).
# Re-generate with: bunx pi-completion zsh > _pi
export PI_COMPLETION_VERSION="0.84.2"

_pi_arguments_after() {
  local skip=$1
  shift
  local -a saved_words
  local saved_current=$CURRENT
  local result
  saved_words=("${words[@]}")
  words=("${words[1]}" "${words[$((skip + 2)),-1]}")
  (( CURRENT -= skip ))
  _arguments "$@"
  result=$?
  words=("${saved_words[@]}")
  CURRENT=$saved_current
  return $result
}

_pi() {
  local context state line
  typeset -A opt_args
  local -a commands
  commands=(
    'install:Install extension source and add to settings'
    'remove:Remove extension source from settings'
    'uninstall:Remove extension source from settings (alias)'
    'update:Update pi, extensions, or model catalogs'
    'list:List installed extensions from settings'
    'config:Open TUI to enable/disable package resources'
    'auth:Print credentials for external clients'
    'mcp:Configure and check MCP servers and sign in to OAuth servers'
  )

  if (( CURRENT == 2 )); then
    _describe -t commands 'pi command' commands
    _arguments \
      '--provider[Provider name (default: google)]:provider:' \
      '--model[Model pattern or ID]:model:' \
      '--api-key[API key (defaults to env vars)]:key:' \
      '--system-prompt[System prompt]:text:' \
      '--append-system-prompt[Append text or file contents to the system prompt]:text:' \
      '--mode[Output mode]:mode:(text json rpc)' \
      '--print[Non-interactive mode: process prompt and exit]' \
      '-p[Non-interactive mode: process prompt and exit]' \
      '--continue[Continue previous session]' \
      '-c[Continue previous session]' \
      '--resume[Select a session to resume]' \
      '-r[Select a session to resume]' \
      '--session[Use specific session file or partial UUID]:path|id:' \
      '--session-id[Use exact project session ID]:id:' \
      '--fork[Fork specific session into a new session]:path|id:' \
      '--session-dir[Directory for session storage and lookup]:directory:_files -/' \
      '--no-session[Don'\''t save session (ephemeral)]' \
      '--name[Set session display name]:name:' \
      '-n[Set session display name]:name:' \
      '--models[Comma-separated model patterns for Ctrl+P cycling]:patterns:' \
      '--no-tools[Disable all tools by default]' \
      '-nt[Disable all tools by default]' \
      '--no-builtin-tools[Disable built-in tools by default but keep extension/custom tools]' \
      '-nbt[Disable built-in tools by default but keep extension/custom tools]' \
      '--tools[Comma-separated allowlist of tool names to enable]:tools:' \
      '-t[Comma-separated allowlist of tool names to enable]:tools:' \
      '--exclude-tools[Comma-separated denylist of tool names to disable]:tools:' \
      '-xt[Comma-separated denylist of tool names to disable]:tools:' \
      '--thinking[Set thinking level]:mode:(off minimal low medium high xhigh max)' \
      '--extension[Load an extension file]:file:_files' \
      '-e[Load an extension file]:file:_files' \
      '--no-extensions[Disable extension discovery]' \
      '-ne[Disable extension discovery]' \
      '--no-mcp[Disable built-in MCP support: no servers connect and no MCP tools]' \
      '--skill[Load a skill file or directory]:file:_files' \
      '--no-skills[Disable skills discovery and loading]' \
      '-ns[Disable skills discovery and loading]' \
      '--prompt-template[Load a prompt template file or directory]:file:_files' \
      '--no-prompt-templates[Disable prompt template discovery]' \
      '-np[Disable prompt template discovery]' \
      '--theme[Load a theme file or directory]:file:_files' \
      '--use-theme[Set the initial interactive theme]:name[/name]:' \
      '--no-themes[Disable theme discovery and loading]' \
      '--no-context-files[Disable AGENTS.md and CLAUDE.md discovery]' \
      '-nc[Disable AGENTS.md and CLAUDE.md discovery]' \
      '--export[Export session file to HTML and exit]:file:_files' \
      '--list-models[List available models (with optional fuzzy search)]' \
      '--verbose[Force verbose startup]' \
      '--tui-mode[TUI mode]:mode:(regular fullscreen)' \
      '--approve[Trust project-local files for this run]' \
      '-a[Trust project-local files for this run]' \
      '--no-approve[Ignore project-local files for this run]' \
      '-na[Ignore project-local files for this run]' \
      '--offline[Disable startup network operations]' \
      '--help[Show help]' \
      '-h[Show help]' \
      '--version[Show version number]' \
      '-v[Show version number]'
    return
  fi

  case $words[2] in
    'install')
      _pi_arguments_after 1 \
        '--local[Install project-locally (.pi/settings.json)]' \
        '-l[Install project-locally (.pi/settings.json)]' \
        '--approve[Trust project-local files for this command]' \
        '-a[Trust project-local files for this command]' \
        '--no-approve[Ignore project-local files for this command]' \
        '-na[Ignore project-local files for this command]' \
        '--help[Show help]' \
        '-h[Show help]'
      ;;
    'remove'|'uninstall')
      _pi_arguments_after 1 \
        '--local[Remove from project settings (.pi/settings.json)]' \
        '-l[Remove from project settings (.pi/settings.json)]' \
        '--approve[Trust project-local files for this command]' \
        '-a[Trust project-local files for this command]' \
        '--no-approve[Ignore project-local files for this command]' \
        '-na[Ignore project-local files for this command]' \
        '--help[Show help]' \
        '-h[Show help]'
      ;;
    'update')
      _pi_arguments_after 1 \
        '--self[Update pi only]' \
        '--extensions[Update installed packages only]' \
        '--models[Refresh model catalogs only]' \
        '--all[Update pi and installed packages]' \
        '--extension[Update one package only]:source:' \
        '--force[Reinstall pi even if the current version is latest]' \
        '--approve[Trust project-local files for this command]' \
        '-a[Trust project-local files for this command]' \
        '--no-approve[Ignore project-local files for this command]' \
        '-na[Ignore project-local files for this command]' \
        '--help[Show help]' \
        '-h[Show help]'
      ;;
    'list')
      _pi_arguments_after 1 \
        '--approve[Trust project-local files for this command]' \
        '-a[Trust project-local files for this command]' \
        '--no-approve[Ignore project-local files for this command]' \
        '-na[Ignore project-local files for this command]' \
        '--help[Show help]' \
        '-h[Show help]'
      ;;
    'config')
      _pi_arguments_after 1 \
        '--local[Edit project overrides (.pi/settings.json)]' \
        '-l[Edit project overrides (.pi/settings.json)]' \
        '--approve[Trust project-local files for this command]' \
        '-a[Trust project-local files for this command]' \
        '--no-approve[Ignore project-local files for this command]' \
        '-na[Ignore project-local files for this command]' \
        '--help[Show help]' \
        '-h[Show help]'
      ;;
    'auth')
      local -a auth_commands
      auth_commands=(
        'check:Check provider readiness'
        'print-api-key:Print a provider API key'
        'print-bearer-token:Print an OAuth bearer token'
      )
      if (( CURRENT == 3 )); then
        _describe -t commands 'auth command' auth_commands
        return
      fi
      case $words[3] in
        'check')
          _pi_arguments_after 2 \
            '--provider[Provider name]:provider:' \
            '--model[Model pattern or ID]:model:' \
            '--json[Output result as JSON]' \
            '--credentials[Emit the credential (or include it in JSON)]' \
            '--no-refresh[Do not refresh expired OAuth credentials]' \
            '--help[Show help]' \
            '-h[Show help]'
          ;;
        'print-api-key')
          _pi_arguments_after 2 \
            '--provider[Provider name]:provider:' \
            '--model[Model pattern or ID]:model:' \
            '--help[Show help]' \
            '-h[Show help]'
          ;;
        'print-bearer-token')
          _pi_arguments_after 2 \
            '--provider[Provider name]:provider:' \
            '--model[Model pattern or ID]:model:' \
            '--min-expiry[Minimum expiry duration (e.g. 30m, 1h)]:duration:' \
            '--help[Show help]' \
            '-h[Show help]'
          ;;
      esac
      ;;
    'mcp')
      local -a mcp_commands
      mcp_commands=(
        'add:Add or replace a server in mcp.json'
        'remove:Remove a server from mcp.json'
        'list:Show state, tools, and errors'
        'login:Sign in through the browser'
        'logout:Delete the stored OAuth credentials'
      )
      if (( CURRENT == 3 )); then
        _describe -t commands 'mcp command' mcp_commands
        return
      fi
      case $words[3] in
        'add')
          _pi_arguments_after 2 \
            '--url[Streamable HTTP server URL]:url:' \
            '--env[Environment variable for a stdio server]:KEY=VALUE:' \
            '--cwd[Working directory for a stdio server]:directory:_files -/' \
            '--header[HTTP header]:KEY=VALUE:' \
            '--bearer-token-env-var[Send Authorization Bearer from env var]:NAME:' \
            '--oauth-client-id[Pre-registered OAuth client id]:id:' \
            '--oauth-client-secret[OAuth client secret]:secret:' \
            '--oauth-callback-port[Fixed OAuth callback port]:port:' \
            '--oauth-client-name[Client name sent when registering]:name:' \
            '--exposure[Exposure mode]:mode:(codemode deferred direct hidden)' \
            '--description[What the server offers]:text:' \
            '--local[Use .pi/mcp.json in the current project]' \
            '-l[Use .pi/mcp.json in the current project]' \
            '--help[Show help]' \
            '-h[Show help]'
          ;;
        'remove')
          _pi_arguments_after 2 \
            '--local[Use .pi/mcp.json in the current project]' \
            '-l[Use .pi/mcp.json in the current project]' \
            '--help[Show help]' \
            '-h[Show help]'
          ;;
        'list')
          _pi_arguments_after 2 \
            '--json[Print the list as JSON]' \
            '--help[Show help]' \
            '-h[Show help]'
          ;;
        'login')
          _pi_arguments_after 2 \
            '--timeout[Timeout in seconds]:seconds:' \
            '--help[Show help]' \
            '-h[Show help]'
          ;;
        'logout')
          _pi_arguments_after 2 \
            '--help[Show help]' \
            '-h[Show help]'
          ;;
      esac
      ;;
    *)
      _arguments \
        '--provider[Provider name (default: google)]:provider:' \
        '--model[Model pattern or ID]:model:' \
        '--api-key[API key (defaults to env vars)]:key:' \
        '--system-prompt[System prompt]:text:' \
        '--append-system-prompt[Append text or file contents to the system prompt]:text:' \
        '--mode[Output mode]:mode:(text json rpc)' \
        '--print[Non-interactive mode: process prompt and exit]' \
        '-p[Non-interactive mode: process prompt and exit]' \
        '--continue[Continue previous session]' \
        '-c[Continue previous session]' \
        '--resume[Select a session to resume]' \
        '-r[Select a session to resume]' \
        '--session[Use specific session file or partial UUID]:path|id:' \
        '--session-id[Use exact project session ID]:id:' \
        '--fork[Fork specific session into a new session]:path|id:' \
        '--session-dir[Directory for session storage and lookup]:directory:_files -/' \
        '--no-session[Don'\''t save session (ephemeral)]' \
        '--name[Set session display name]:name:' \
        '-n[Set session display name]:name:' \
        '--models[Comma-separated model patterns for Ctrl+P cycling]:patterns:' \
        '--no-tools[Disable all tools by default]' \
        '-nt[Disable all tools by default]' \
        '--no-builtin-tools[Disable built-in tools by default but keep extension/custom tools]' \
        '-nbt[Disable built-in tools by default but keep extension/custom tools]' \
        '--tools[Comma-separated allowlist of tool names to enable]:tools:' \
        '-t[Comma-separated allowlist of tool names to enable]:tools:' \
        '--exclude-tools[Comma-separated denylist of tool names to disable]:tools:' \
        '-xt[Comma-separated denylist of tool names to disable]:tools:' \
        '--thinking[Set thinking level]:mode:(off minimal low medium high xhigh max)' \
        '--extension[Load an extension file]:file:_files' \
        '-e[Load an extension file]:file:_files' \
        '--no-extensions[Disable extension discovery]' \
        '-ne[Disable extension discovery]' \
        '--no-mcp[Disable built-in MCP support: no servers connect and no MCP tools]' \
        '--skill[Load a skill file or directory]:file:_files' \
        '--no-skills[Disable skills discovery and loading]' \
        '-ns[Disable skills discovery and loading]' \
        '--prompt-template[Load a prompt template file or directory]:file:_files' \
        '--no-prompt-templates[Disable prompt template discovery]' \
        '-np[Disable prompt template discovery]' \
        '--theme[Load a theme file or directory]:file:_files' \
        '--use-theme[Set the initial interactive theme]:name[/name]:' \
        '--no-themes[Disable theme discovery and loading]' \
        '--no-context-files[Disable AGENTS.md and CLAUDE.md discovery]' \
        '-nc[Disable AGENTS.md and CLAUDE.md discovery]' \
        '--export[Export session file to HTML and exit]:file:_files' \
        '--list-models[List available models (with optional fuzzy search)]' \
        '--verbose[Force verbose startup]' \
        '--tui-mode[TUI mode]:mode:(regular fullscreen)' \
        '--approve[Trust project-local files for this run]' \
        '-a[Trust project-local files for this run]' \
        '--no-approve[Ignore project-local files for this run]' \
        '-na[Ignore project-local files for this run]' \
        '--offline[Disable startup network operations]' \
        '--help[Show help]' \
        '-h[Show help]' \
        '--version[Show version number]' \
        '-v[Show version number]'
      ;;
  esac
}

# Do not run the completion function when the file is sourced manually.
if [[ "$funcstack[1]" = "_pi" ]]; then
  _pi
fi
